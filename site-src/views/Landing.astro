---
import '../styles/site.css';

interface Props { locale: 'zh' | 'en' }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const home = isZh ? '/' : '/en/';
const other = isZh ? '/en/' : '/';
const t = {
  zh: {
    title: '工程图纸转三维 CAD | 尺寸核对与 STEP / STL 交付',
    description: '将尺寸明确的 PDF / DXF 工程图重建为三维 CAD，交付 STEP、STL、三视图和关键尺寸核对报告。缺失与冲突标注先人工确认。',
    brand: '图纸转三维 CAD', nav: ['合作流程', '样品对比', '演示视频', '交付内容', '试单'],
    locale: 'EN', cta: '准备试单', badge: '工程建模服务 · 原创样品 LPB-01',
    heroA: '从二维图纸', heroB: '到可核对的三维 CAD',
    heroBody: '尺寸明确的 PDF / DXF，重建为 STEP、STL 与可审查的技术资料。疑点先确认，关键尺寸逐项记录。',
    watch: '观看 20 秒演示', report: '查看核对报告',
    heroNote: '展示零件：两件式插销安装支架',
    metrics: [['80 × 40 × 50 mm','支架外形'],['2 × Ø6.6','安装孔'],['STEP + STL','模型交付']],
    processEyebrow: 'HOW IT WORKS', processTitle: '三步完成可审查的交付',
    processLead: '每一步都说明输入、需要确认的事项和最终文件。',
    steps: [
      ['01','提交图纸','先做适建性检查，再确认工作范围与报价。','尺寸清晰的 PDF / DXF、零件用途、目标格式','确认范围与待答问题'],
      ['02','逐项澄清，再建模','发现缺失或冲突时先暂停相关特征，记录问题并等你确认。','缺失尺寸、视图冲突、适用的假设与公差要求','按确认版尺寸建立 CAD 实体'],
      ['03','核对后交付','核对关键尺寸与导出文件；说明检查覆盖范围及未验证事项。','模型、尺寸对照表和交付文件','STEP / STL、三视图与检查记录'],
    ],
    compareEyebrow: '2D ↔ 3D', compareTitle: '同一件样品，从图纸到模型',
    compareLead: '拖动分隔线查看视觉对比。图纸与模型的尺寸关系请以下方核对表为准。',
    before: '原始二维图纸', after: '三维 CAD 装配', slider: '调整二维图纸与三维模型的可视比例',
    sampleTag: '原创演示样品 · Rev A', downloadDrawing: '下载图纸 PDF', downloadStep: '下载装配 STEP',
    checkTitle: '关键尺寸核对', checkLead: '程序检查了原生实体、STEP 回读和 STL 外形；量产公差仍需工程审图。',
    checkCols: ['图纸标注','模型检查','结果'],
    checks: [
      ['支架外形 80 × 40 × 50 mm','原生模型与 STEP 回读包围盒一致','一致'],
      ['安装孔 2 × Ø6.6；X25 / X65，Y20','圆边半径 3.3；上下表面孔位一致','一致'],
      ['插销孔 Ø10.2；Y20，Z30','两端圆边半径 5.1，中心位置一致','一致'],
      ['插销 Ø10 × 48，头部 Ø16 × 3','圆边与轴向范围一致','一致'],
    ],
    videoEyebrow: '20-SECOND DEMO', videoTitle: '20 秒看完整个转换过程',
    videoLead: '视频展示原始图纸、装配模型、三视图与检查结果。视频无配音，画面文字说明各步骤。',
    deliverEyebrow: 'DELIVERABLES', deliverTitle: '一套方便复核和继续使用的文件',
    deliverLead: '这里展示的是本样品实际生成的文件。客户项目按确认后的图纸和约定格式交付。',
    deliver: [
      ['CAD 实体','装配与零件 STEP，适合在常见 CAD 系统中打开和继续处理。','下载 STEP','/assets/assembly.step'],
      ['网格预览','支架与插销的独立 STL，可用于预览和网格工作流。','下载 STL','/assets/bracket.stl'],
      ['技术展示','正视、侧视和等轴测视图，快速核对零件形态。','查看展示图','/assets/technical-showcase.png'],
      ['对比报告','记录外形、孔径、孔位、STEP 回读结果和待确认项。','查看 PDF 报告','/assets/comparison-report.pdf'],
    ],
    boundaryTitle: '遇到缺失或矛盾标注，先把问题说清楚',
    boundaryBody: '照片、模糊扫描件、缺失尺寸或无法确认的公差不会被默认为精确输入。我们先提供问题清单，请客户补充或确认假设，再确定建模范围。',
    boundaryExample: '本样品的 Ø10.2 孔与 Ø10 插销只有 0.2 mm 名义直径间隙，不代表已确定制造配合公差。',
    priceEyebrow: 'PILOT PROJECT', priceTitle: '从一件小项目开始',
    priceBody: '适用于一套最多 2 个简单机械零件、尺寸明确的 PDF / DXF。关键问题确认后，目标交付时间为 3 个工作日，含一次小修订。',
    priceZh: '¥1,299', priceEn: 'US$199', priceNote: '试单固定价 · 超出范围另行确认',
    briefTitle: '填写试单信息', briefBody: '填写项目需求和联系邮箱，点击发送后会打开邮件草稿。图纸请在邮件中添加附件；网站不会接收或保存图纸。',
    copy: '复制询价清单', copied: '已复制询价清单', copyFail: '复制失败，请手动选择文本',
    brief: '项目名称：\n图纸格式与页数：\n零件数量：\n零件用途：\n需要的文件格式（STEP / STL / 工程图）：\n已知缺失尺寸或公差：\n期望完成时间：',
    faqTitle: '常见问题',
    faqs: [
      ['模糊照片能全自动精确变成 3D 吗？','不能。可识别的几何与尺寸需要人工核对；缺失尺寸必须由客户补充或确认假设。'],
      ['STEP 和 STL 有什么区别？','STEP 保留 CAD 实体几何，便于在 CAD 软件中继续处理；STL 是三角网格，适合预览和部分制造流程，不含特征历史。'],
      ['样品代表量产图纸吗？','本样品展示名义几何和尺寸检查。材料、表面处理、配合等级及量产公差仍需客户或机械设计人员确认。'],
    ],
    footer: '基于原创插销支架样品建立的服务展示。所有客户项目均以确认后的图纸为依据。',
  },
  en: {
    title: '2D Drawing to 3D CAD | Dimension Checks & STEP / STL Delivery',
    description: 'Rebuild clearly dimensioned PDF / DXF engineering drawings as 3D CAD, with STEP, STL, three-view previews and a dimension traceability report. Ambiguities require human confirmation.',
    brand: 'Drawing to 3D CAD', nav: ['Process', 'Case study', '20s demo', 'Deliverables', 'Pilot'],
    locale: '中文', cta: 'Plan a pilot', badge: 'Engineering modeling service · original LPB-01 sample',
    heroA: 'From 2D drawings', heroB: 'to reviewable 3D CAD',
    heroBody: 'Clearly dimensioned PDF / DXF drawings become STEP, STL and traceable technical materials. Open questions are confirmed before modeling.',
    watch: 'Watch the 20s demo', report: 'Read the check report',
    heroNote: 'Featured part: two-piece locating-pin bracket',
    metrics: [['80 × 40 × 50 mm','Bracket envelope'],['2 × Ø6.6','Mounting holes'],['STEP + STL','CAD delivery']],
    processEyebrow: 'HOW IT WORKS', processTitle: 'Three steps to a reviewable handoff',
    processLead: 'Each step makes the input, open questions and final files clear.',
    steps: [
      ['01','Send the drawing','We check suitability, then agree the scope and quote.','Clear PDF / DXF, part use and target formats','Agreed scope and open questions'],
      ['02','Resolve questions, then model','If dimensions are missing or conflict, we flag them before modeling affected features.','Missing values, view conflicts, assumptions and tolerance needs','CAD built to the confirmed dimensions'],
      ['03','Check and hand off','We check key dimensions and exports, and state what was and was not verified.','Model, dimension record and delivery files','STEP / STL, three views and check record'],
    ],
    compareEyebrow: '2D ↔ 3D', compareTitle: 'One sample, from drawing to model',
    compareLead: 'Drag the divider for a visual comparison. Use the check table below for dimension traceability.',
    before: 'Original 2D drawing', after: '3D CAD assembly', slider: 'Adjust the visible split between drawing and model',
    sampleTag: 'Original demonstrator · Rev A', downloadDrawing: 'Download drawing PDF', downloadStep: 'Download assembly STEP',
    checkTitle: 'Key dimension checks', checkLead: 'Native solids, STEP re-import and STL envelopes were checked in code. Production tolerances still need engineering review.',
    checkCols: ['Drawing callout','CAD check','Result'],
    checks: [
      ['Bracket envelope 80 × 40 × 50 mm','Native and STEP re-import bounds agree','MATCH'],
      ['Mount holes 2 × Ø6.6; X25 / X65, Y20','R3.3 circular edges at both faces','MATCH'],
      ['Pin bore Ø10.2; Y20, Z30','R5.1 circles and center locations agree','MATCH'],
      ['Pin Ø10 × 48; head Ø16 × 3','Circular edges and axial extents agree','MATCH'],
    ],
    videoEyebrow: '20-SECOND DEMO', videoTitle: 'See the transformation in 20 seconds',
    videoLead: 'The silent video shows the source drawing, assembly, three views and check summary with on-screen labels.',
    deliverEyebrow: 'DELIVERABLES', deliverTitle: 'Files ready to review and reuse',
    deliverLead: 'These files were generated for this sample. Client work follows the confirmed drawing and agreed formats.',
    deliver: [
      ['CAD solids','Assembly and part STEP files for opening and further work in common CAD systems.','Download STEP','/assets/assembly.step'],
      ['Mesh previews','Separate bracket and pin STL files for viewing and mesh workflows.','Download STL','/assets/bracket.stl'],
      ['Technical views','Front, side and isometric views for a quick shape review.','View the sheet','/assets/technical-showcase.png'],
      ['Traceability report','Envelope, hole, STEP re-import checks and open points in one PDF.','Read PDF report','/assets/comparison-report.pdf'],
    ],
    boundaryTitle: 'Missing or conflicting callouts are resolved first',
    boundaryBody: 'Photos, blurry scans, missing dimensions and unknown tolerances are not treated as precise input. We list questions, then ask the client to supply details or approve explicit assumptions.',
    boundaryExample: 'The sample’s Ø10.2 bore and Ø10 pin have 0.2 mm nominal diametral clearance; this does not establish a production fit tolerance.',
    priceEyebrow: 'PILOT PROJECT', priceTitle: 'Start with one small project',
    priceBody: 'One clearly dimensioned PDF / DXF covering up to two simple mechanical parts. Target delivery is three business days after key questions are settled, with one minor revision.',
    priceZh: '¥1,299', priceEn: 'US$199', priceNote: 'Fixed pilot offer · expanded scope quoted separately',
    briefTitle: 'Send a project inquiry', briefBody: 'Fill in the project details and contact email, then send. Add your drawing as an attachment in the email draft. This site does not receive or store drawings.',
    copy: 'Copy inquiry checklist', copied: 'Checklist copied', copyFail: 'Copy failed; please select the text manually',
    brief: 'Project name:\nDrawing format and page count:\nPart count:\nIntended use:\nNeeded files (STEP / STL / drawing):\nKnown missing dimensions or tolerances:\nDesired deadline:',
    faqTitle: 'Frequently asked questions',
    faqs: [
      ['Can any blurry photo become an exact 3D model automatically?','No. Geometry and dimensions need human review; missing dimensions require client input or approved assumptions.'],
      ['What is the difference between STEP and STL?','STEP carries solid CAD geometry for further work; STL is a triangle mesh for viewing and some manufacturing workflows, without feature history.'],
      ['Is this sample a production drawing?','It demonstrates nominal geometry and dimension checks. Material, finish, fit class and production tolerances require confirmation by the client or a mechanical engineer.'],
    ],
    footer: 'Service presentation built around an original locating-pin bracket sample. Client work follows the confirmed drawing.',
  }
}[locale];

const navIds = ['process','case-study','demo','deliverables','pilot'];
---

<!doctype html>
<html lang={isZh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#10253d" />
    <meta name="description" content={t.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(home, Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:image" content={new URL('/assets/technical-showcase.png', Astro.site)} />
    <title>{t.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{isZh ? '跳到正文' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={home} aria-label={t.brand}>
          <span class="brand-mark" aria-hidden="true"><span></span></span>
          <span>{t.brand}</span>
        </a>
        <button class="menu-toggle" type="button" aria-label={isZh ? '打开菜单' : 'Open menu'} aria-expanded="false" aria-controls="site-nav">
          <span></span><span></span><span></span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label={isZh ? '主导航' : 'Main navigation'}>
          {t.nav.map((label, i) => <a href={`${home}#${navIds[i]}`}>{label}</a>)}
          <a class="language-link" href={other} lang={isZh ? 'en' : 'zh-CN'}>{t.locale}</a>
          <a class="nav-cta" href={`${home}#pilot`}>{t.cta}<span aria-hidden="true"> ↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-dot"></span>{t.badge}</div>
          <h1 id="hero-title">{t.heroA}<br /><span>{t.heroB}</span></h1>
          <p class="hero-lead">{t.heroBody}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#demo">{t.watch}<span aria-hidden="true"> →</span></a>
            <a class="button button-outline" href="/assets/comparison-report.pdf" target="_blank" rel="noopener">{t.report}<span aria-hidden="true"> ↗</span></a>
          </div>
          <p class="hero-footnote">{t.heroNote}</p>
        </div>
        <div class="hero-visual">
          <div class="hero-grid" aria-hidden="true"></div>
          <span class="visual-tag">LPB-01 <span>REV A</span></span>
          <img src="/assets/isometric.png" alt={isZh ? '蓝色 L 形安装支架与橙色插销的等轴测三维视图' : 'Isometric view of a blue L bracket and orange locating pin'} width="1400" height="1000" fetchpriority="high" />
          <span class="file-tag">STEP <i></i> STL</span>
        </div>
      </section>

      <section class="metrics shell" aria-label={isZh ? '样品参数' : 'Sample specifications'}>
        {t.metrics.map(([value,label]) => <div><strong>{value}</strong><span>{label}</span></div>)}
      </section>

      <section class="section shell" id="process" aria-labelledby="process-title">
        <div class="section-intro">
          <span class="section-kicker">{t.processEyebrow}</span>
          <h2 id="process-title">{t.processTitle}</h2>
          <p>{t.processLead}</p>
        </div>
        <div class="steps-grid">
          {t.steps.map(([number,title,body,customer,result]) => <article class="step-card"><span class="step-number">{number}</span><h3>{title}</h3><p>{body}</p><div class="step-detail"><strong>{isZh ? '客户参与' : 'Your input'}</strong><span>{customer}</span></div><div class="step-detail step-result"><strong>{isZh ? '阶段结果' : 'Milestone'}</strong><span>{result}</span></div></article>)}
        </div>
      </section>

      <section class="case-section" id="case-study" aria-labelledby="case-title">
        <div class="shell">
          <div class="section-intro case-intro">
            <span class="section-kicker">{t.compareEyebrow}</span>
            <h2 id="case-title">{t.compareTitle}</h2>
            <p>{t.compareLead}</p>
          </div>
          <div class="compare-panel">
            <div class="compare-topline"><span>{t.sampleTag}</span><span>LPB-01</span></div>
            <div class="compare-stage" style="--split: 50%">
              <div class="compare-before"><img src="/assets/source-drawing.png" alt={t.before} width="1819" height="1287" loading="lazy" /></div>
              <div class="compare-after"><img src="/assets/isometric.png" alt={t.after} width="1400" height="1000" loading="lazy" /></div>
              <div class="compare-divider" aria-hidden="true"><span>↔</span></div>
              <input class="compare-range" type="range" min="0" max="100" value="50" aria-label={t.slider} />
              <span class="compare-label compare-label-before">2D</span>
              <span class="compare-label compare-label-after">3D</span>
            </div>
            <div class="compare-actions">
              <a href="/assets/source-drawing.pdf" download>{t.downloadDrawing} <span aria-hidden="true">↓</span></a>
              <a href="/assets/assembly.step" download>{t.downloadStep} <span aria-hidden="true">↓</span></a>
            </div>
          </div>

          <div class="check-heading"><h3>{t.checkTitle}</h3><p>{t.checkLead}</p></div>
          <div class="check-table-wrap"><table class="check-table"><thead><tr>{t.checkCols.map(label => <th scope="col">{label}</th>)}</tr></thead><tbody>{t.checks.map(([drawing,model,result]) => <tr><td>{drawing}</td><td>{model}</td><td><span class="pass-badge"><span aria-hidden="true">✓</span> {result}</span></td></tr>)}</tbody></table></div>
        </div>
      </section>

      <section class="section shell video-section" id="demo" aria-labelledby="video-title">
        <div class="video-copy"><span class="section-kicker">{t.videoEyebrow}</span><h2 id="video-title">{t.videoTitle}</h2><p>{t.videoLead}</p><a class="text-link" href="/assets/demo.mp4" download>{isZh ? '下载演示视频' : 'Download the demo'} <span aria-hidden="true">↗</span></a></div>
        <div class="video-frame"><video controls playsinline preload="metadata" poster="/assets/video-poster.png" aria-label={t.videoTitle}><source src="/assets/demo.mp4" type="video/mp4" /></video></div>
      </section>

      <section class="section shell" id="deliverables" aria-labelledby="deliver-title">
        <div class="section-intro"><span class="section-kicker">{t.deliverEyebrow}</span><h2 id="deliver-title">{t.deliverTitle}</h2><p>{t.deliverLead}</p></div>
        <div class="deliver-grid">
          {t.deliver.map(([title,body,label,url],i) => <article class="deliver-card"><span class="deliver-index">0{i+1}</span><h3>{title}</h3><p>{body}</p><a href={url} download={url.endsWith('.step') || url.endsWith('.stl') ? true : undefined} target={url.endsWith('.pdf') || url.endsWith('.png') ? '_blank' : undefined} rel="noopener">{label} <span aria-hidden="true">↗</span></a></article>)}
        </div>
        <div class="all-files"><a href="/assets/sample-package.zip" download>{isZh ? '下载完整样品包 ZIP' : 'Download the complete sample ZIP'} <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="boundary shell" aria-labelledby="boundary-title">
        <div class="boundary-symbol" aria-hidden="true">!</div>
        <div><h2 id="boundary-title">{t.boundaryTitle}</h2><p>{t.boundaryBody}</p><p class="boundary-example">{t.boundaryExample}</p></div>
      </section>

      <section class="section shell pilot-section" id="pilot" aria-labelledby="pilot-title">
        <div class="pilot-card"><span class="section-kicker">{t.priceEyebrow}</span><h2 id="pilot-title">{t.priceTitle}</h2><p>{t.priceBody}</p><div class="prices"><div><span>{isZh ? '国内试单' : 'China pilot'}</span><strong>{t.priceZh}</strong></div><div><span>{isZh ? '海外试单' : 'International pilot'}</span><strong>{t.priceEn}</strong></div></div><small>{t.priceNote}</small></div>
        <div class="brief-card"><h3>{t.briefTitle}</h3><p>{t.briefBody}</p>
          <form class="inquiry-form" data-inquiry-form data-recipient="zexuanzjb@gmail.com" novalidate>
            <label>{isZh ? '联系邮箱（必填）' : 'Contact email (required)'}<input type="email" name="contactEmail" autocomplete="email" placeholder={isZh ? 'name@example.com' : 'name@example.com'} required /></label>
            <label>{isZh ? '项目名称（必填）' : 'Project name (required)'}<input name="projectName" required /></label>
            <div class="form-row"><label>{isZh ? '图纸格式与页数' : 'Drawing format and pages'}<input name="drawing" placeholder="PDF / DXF" /></label><label>{isZh ? '零件数量' : 'Part count'}<input name="partCount" type="number" min="1" inputmode="numeric" /></label></div>
            <label>{isZh ? '零件用途' : 'Intended use'}<input name="intendedUse" /></label>
            <label>{isZh ? '需要的文件格式' : 'Required file formats'}<select name="formats" multiple size="3" aria-label={isZh ? '选择需要的文件格式' : 'Select required file formats'}><option value="STEP">STEP</option><option value="STL">STL</option><option value={isZh ? '工程图' : '2D drawing'}>{isZh ? '工程图' : '2D drawing'}</option></select></label>
            <label>{isZh ? '已知缺失尺寸或公差' : 'Known missing dimensions or tolerances'}<textarea name="openQuestions" rows="3"></textarea></label>
            <label>{isZh ? '期望完成时间' : 'Desired deadline'}<input name="deadline" /></label>
            <button class="button button-primary send-button" type="submit">{isZh ? '发送询价' : 'Send inquiry'} <span aria-hidden="true">→</span></button>
            <p class="copy-status" data-form-status role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>

      <section class="section shell faq-section" aria-labelledby="faq-title"><h2 id="faq-title">{t.faqTitle}</h2><div class="faq-list">{t.faqs.map(([q,a]) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>
    </main>

    <footer class="site-footer"><div class="shell footer-inner"><div><strong>{t.brand}</strong><p>{t.footer}</p></div><div class="footer-links"><a href={home}>{isZh ? '返回顶部' : 'Back to top'} ↑</a><a href="/assets/source-drawing.pdf" target="_blank" rel="noopener">PDF</a><a href="/assets/assembly.step" download>STEP</a></div></div><div class="shell template-credit">{isZh ? '网站架构基于 MIT 开源模板 ScrewFast 二次创作。' : 'Site architecture adapted from the MIT-licensed ScrewFast template.'}</div></footer>

    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.site-nav');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('open', open);
      });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        nav.classList.remove('open');
      }));
      document.querySelectorAll<HTMLElement>('.compare-stage').forEach(stage => {
        const range = stage.querySelector<HTMLInputElement>('.compare-range');
        range?.addEventListener('input', () => stage.style.setProperty('--split', `${range.value}%`));
      });
      const inquiryForm = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
      inquiryForm?.addEventListener('submit', event => {
        event.preventDefault();
        const status = inquiryForm.querySelector<HTMLElement>('[data-form-status]');
        if (!inquiryForm.reportValidity()) return;
        const recipient = inquiryForm.dataset.recipient?.trim();
        if (!recipient) {
          if (status) status.textContent = document.documentElement.lang.startsWith('zh') ? '收件邮箱尚未配置，请稍后再试。' : 'The receiving email is not configured yet. Please try again later.';
          return;
        }
        const data = new FormData(inquiryForm);
        const formats = data.getAll('formats').join(', ') || 'Not specified';
        const lines = [
          `Contact email: ${data.get('contactEmail')}`, `Project: ${data.get('projectName')}`,
          `Drawing: ${data.get('drawing') || 'Not specified'}`, `Part count: ${data.get('partCount') || 'Not specified'}`,
          `Intended use: ${data.get('intendedUse') || 'Not specified'}`, `Required formats: ${formats}`,
          `Open dimensions / tolerances: ${data.get('openQuestions') || 'Not specified'}`, `Desired deadline: ${data.get('deadline') || 'Not specified'}`
        ];
        const subject = `CAD inquiry — ${data.get('projectName')}`;
        window.location.href = `mailto:${encodeURIComponent(recipient)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
      });
    </script>
  </body>
</html>
